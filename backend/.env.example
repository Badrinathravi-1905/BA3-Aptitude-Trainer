# SQLite for local dev. For production use your PostgreSQL URL, e.g.
# postgresql://user:password@host:5432/dbname  (postgres:// also accepted)
DATABASE_URL=sqlite:///./ba3.db
# Comma-separated list of frontend origins allowed by CORS (no wildcard)
ALLOWED_ORIGINS=http://localhost:5173
# Long random string used to sign question tokens. CHANGE IN PRODUCTION.
SECRET_KEY=change-me-to-a-long-random-string
